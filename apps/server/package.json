{
  "name": "@ubuliera/server",
  "version": "0.1.0",
  "private": true,
  "description": "Ubuliera orchestrator: Hono API, Socket.IO realtime, MCP endpoint, runtime adapters",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "cross-env NODE_ENV=production node dist/main.js",
    "start:e2e": "cross-env NODE_ENV=test UBULIERA_TEST_FAKE_RUNTIME=1 node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "jsep": "1.4.0",
    "node-pty": "1.1.0",
    "picomatch": "4.0.7",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/picomatch": "4.0.3",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
